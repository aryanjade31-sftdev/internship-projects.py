# EXPLORATORY DATA ANALYSIS (EDA) PROJECT
# ==========================================

# Import Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.datasets import load_breast_cancer

# --------------------------------------
# STEP 1: Load Dataset
# --------------------------------------

# Load built-in dataset
data = load_breast_cancer()

# Convert to DataFrame
df = pd.DataFrame(
    data.data,
    columns=data.feature_names
)

# Add target column
df['target'] = data.target

print("First 5 Rows of Dataset")
print(df.head())

# --------------------------------------
# STEP 2: Basic Information
# --------------------------------------

print("\nDataset Information")
print(df.info())

print("\nDataset Shape")
print(df.shape)

print("\nColumn Names")
print(df.columns)

# --------------------------------------
# STEP 3: Missing Values
# --------------------------------------

print("\nMissing Values")
print(df.isnull().sum())

# --------------------------------------
# STEP 4: Statistical Summary
# --------------------------------------

print("\nStatistical Summary")
print(df.describe())

# --------------------------------------
# STEP 5: Check Duplicates
# --------------------------------------

print("\nDuplicate Rows")
print(df.duplicated().sum())

# --------------------------------------
# STEP 6: Correlation Analysis
# --------------------------------------

correlation_matrix = df.corr()

print("\nCorrelation Matrix")
print(correlation_matrix)

# --------------------------------------
# STEP 7: Data Visualization
# --------------------------------------

sns.set_style("whitegrid")

# 1. Distribution Plot
plt.figure(figsize=(8,5))
sns.histplot(df['mean radius'],
             kde=True,
             bins=30)

plt.title("Distribution of Mean Radius")
plt.xlabel("Mean Radius")
plt.ylabel("Frequency")
plt.show()

# --------------------------------------
# 2. Boxplot (Outlier Detection)
# --------------------------------------

plt.figure(figsize=(8,5))
sns.boxplot(x=df['mean area'])

plt.title("Boxplot of Mean Area")
plt.show()

# --------------------------------------
# 3. Correlation Heatmap
# --------------------------------------

plt.figure(figsize=(14,10))

sns.heatmap(
    correlation_matrix,
    cmap='coolwarm'
)

plt.title("Correlation Heatmap")
plt.show()

# --------------------------------------
# 4. Pair Plot
# --------------------------------------

selected_features = [
    'mean radius',
    'mean texture',
    'mean area',
    'mean perimeter',
    'target'
]

sns.pairplot(
    df[selected_features],
    hue='target'
)

plt.show()

# --------------------------------------
# 5. Count Plot
# --------------------------------------

plt.figure(figsize=(6,4))

sns.countplot(x='target', data=df)

plt.title("Target Class Distribution")
plt.xlabel("Target")
plt.ylabel("Count")
plt.show()

# --------------------------------------
# STEP 8: Key Insights
# --------------------------------------

print("\n===== KEY INSIGHTS =====")

print("1. Dataset contains",
      df.shape[0],
      "rows and",
      df.shape[1],
      "columns")

print("2. Missing values present:")
print(df.isnull().sum().sum())

print("3. Duplicate rows:",
      df.duplicated().sum())

print("4. Highly correlated features:")

corr = correlation_matrix['target']\
    .sort_values(ascending=False)

print(corr.head(10))

# --------------------------------------
# STEP 9: Save EDA Report
# --------------------------------------

with open("EDA_Report.txt", "w") as file:

    file.write("EDA REPORT\n")
    file.write("=====================\n\n")

    file.write(f"Dataset Shape: {df.shape}\n\n")

    file.write("Statistical Summary:\n")
    file.write(str(df.describe()))

    file.write("\n\nMissing Values:\n")
    file.write(str(df.isnull().sum()))

    file.write("\n\nDuplicate Rows:\n")
    file.write(str(df.duplicated().sum()))

print("\nEDA report saved as EDA_Report.txt")
